    m_Localized: "Conectando\u2026"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2496881836716033
    m_Localized: "Reconectando\u2026"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2496881840910336
    m_Localized: "Sin conexi\xF3n en tiempo real"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2496881840910337
    m_Localized: "{0} {0:plural:conectado|conectados} \xB7 {1} {1:plural:partida|partidas}
      \xB7 {2} esperando"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011691520000
    m_Localized: Uno contra uno
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463040
    m_Localized: "Dos personas \xB7 Dispositivo compartido"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463041
    m_Localized: Humano
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463042
    m_Localized: "Decidir qui\xE9n sale"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463043
    m_Localized: Escoge una ficha
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463044
    m_Localized: "\xBFLa suma es par o impar?"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463045
    m_Localized: Par
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463046
    m_Localized: Impar
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463047
    m_Localized: Ficha 1
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463048
    m_Localized: Ficha 2
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463049
    m_Localized: "Sumas iguales \u2014 volver a escoger"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463050
    m_Localized: Sale el jugador {0}
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463051
    m_Localized: Turno del jugador {0}
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463052
    m_Localized: Entrega el dispositivo antes de continuar.
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463053
    m_Localized: "Capic\xFAa"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463054
    m_Localized: Tranque
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463055
    m_Localized: J{0}  {1}
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463056
    m_Localized: Tiempo agotado
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463057
    m_Localized: Jugador desconectado
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2784011733463058
    m_Localized: Autoplay
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2929402923741184
    m_Localized: 1 contra 1
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2929402965684224
    m_Localized: "UNO CONTRA UNO \u2014 ONLINE"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2929402965684225
    m_Localized: "Acceso de desarrollo \xB7 Comparte el ID con el segundo jugador."
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2929402965684226
    m_Localized: Crear partida
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2929402965684227
    m_Localized: Unirse a partida
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2929402965684228
    m_Localized: ID de partida
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2929402965684229
    m_Localized: "Esperando al segundo jugador\u2026"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2929402965684230
    m_Localized: "Conexi\xF3n online no disponible. Reintenta al conectar."
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2929402965684231
    m_Localized: "Introduce un ID de partida v\xE1lido."
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2929402965684232
    m_Localized: Partida no encontrada. Revisa el ID.
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2929402965684233
    m_Localized: "Esta partida est\xE1 llena."
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2929402965684234
    m_Localized: Usa otra cuenta de jugador en el segundo cliente.
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2929402965684235
    m_Localized: "Esta partida ya comenz\xF3."
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2929402965684236
    m_Localized: "No se pudo entrar. Revisa la conexi\xF3n e int\xE9ntalo de nuevo."
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 2956237275426816
    m_Localized: '{0} suma {1} puntos.'
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3297437434015744
    m_Localized: Encontrar rival
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3297437471764480
    m_Localized: Buscar oponente
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3297437471764481
    m_Localized: "Todo listo para buscar tu pr\xF3ximo rival"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3297437471764482
    m_Localized: "Preparando tu partida\u2026"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3297437471764483
    m_Localized: "Buscando rival\u2026"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3297437471764484
    m_Localized: "\xA1Oponente encontrado!"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3297437471764485
    m_Localized: "Cancelando b\xFAsqueda\u2026"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3297437471764486
    m_Localized: "No se pudo iniciar la b\xFAsqueda. Int\xE9ntalo de nuevo."
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3297437471764487
    m_Localized: "Buscando \xB7 {0} s"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3304955283533824
    m_Localized: "Entrando a la partida\u2026"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3304955338059776
    m_Localized: "Comprobando si hay una partida activa\u2026"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3304955338059777
    m_Localized: "Reanudando partida\u2026"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3327218598834176
    m_Localized: 2 contra 2 online
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3327218665943040
    m_Localized: "4 jugadores \xB7 En l\xEDnea"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3327218665943041
    m_Localized: Jugar online
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3327218665943042
    m_Localized: "Buscando jugadores\u2026"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3336631518785536
    m_Localized: "Elige tu partida \xB7 {0} modos"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
  - m_Id: 3336631564922880
    m_Localized: "Ver m\xE1s modos \u2193"
    m_Metadata:
      m_Items:
      - rid: 7246862583952572444
